"""Limited-workspace 3D neighborhood attention (NATTEN ``na3d`` semantics) in pure torch.
Vendored from comfy-kitchen ``backends/eager/na.py`` (Apache-2.0) for DiffVAE hosts
without natten or Triton. Queries are tiled; tiles that share window geometry stack
into batched ``scaled_dot_product_attention`` calls with one additive mask per group.
"""

from __future__ import annotations

import math
import os
from collections import OrderedDict

import torch
from torch.nn import functional

# Element budget for one tile's [Nq, Nk] attention mask (bounds the mask
# allocation and, on CPU, the math-backend score materialization).
NA_SCORE_BUDGET = 2**25
# Element budget for the stacked K/V copies of one batched SDPA call on CUDA or XPU.
NA_KV_STACK_BUDGET = 2**28
# XPU tile cap keeps the batched SDPA work-group grid within the measured efficient range.
NA_XPU_KV_STACK_TILE_CAP = 64
# R22 batches equal-shaped tiles from different window geometries for the small-kernel VAE stages.
NA_XPU_REST_MAX_KERNEL = 7
# R28 static gather-index/mask cache: tile geometry is data-independent, so
# per-call index/mask construction kernels are eliminable across steps.
_R28_NA_INDEX_CACHE: dict = {}
_R28_NA_MASK_CACHE: dict = {}
# R22 query-tile extents for XPU small-kernel attention.
NA_XPU_REST_TILE = (3, 8, 8)
NA_XPU_REST_TILE_CAP = 64
# R22 cached mask and gather-index storage limits in bytes.
NA_XPU_REST_STACK_CACHE_BUDGET = 2**31
NA_XPU_REST_INDEX_CACHE_BUDGET = 2**28
_CACHE_MISS = object()


class _BoundedTensorCache:
    def __init__(self, budget_bytes: int):
        self.budget_bytes = int(budget_bytes)
        self.values: OrderedDict[object, torch.Tensor] = OrderedDict()
        self.bytes = 0

    def get(self, key: object):
        value = self.values.get(key, _CACHE_MISS)
        if value is _CACHE_MISS:
            return _CACHE_MISS
        self.values.move_to_end(key)
        return value

    def put(self, key: object, value: torch.Tensor) -> None:
        old = self.values.pop(key, None)
        if old is not None:
            self.bytes -= old.numel() * old.element_size()
        self.values[key] = value
        self.bytes += value.numel() * value.element_size()
        while self.bytes > self.budget_bytes and self.values:
            _, evicted = self.values.popitem(last=False)
            self.bytes -= evicted.numel() * evicted.element_size()


_R22_STACK_CACHE = _BoundedTensorCache(NA_XPU_REST_STACK_CACHE_BUDGET)
_R22_INDEX_CACHE = _BoundedTensorCache(NA_XPU_REST_INDEX_CACHE_BUDGET)


# R29: query-length threshold at which the head-last writeback layout stops
# costing the consuming SDPA call more than the writeback copy saves.
def _r29_g1_gather_enabled() -> bool:
    """Return whether single-tile NA groups use the index_select gather."""
    if os.environ.get("LTX_ALL_ORIG", "0") == "1":
        return False
    value = os.environ.get("LTX_R29_ELEM_NORM", "0")
    if value not in {"0", "1"}:
        raise ValueError("LTX_R29_ELEM_NORM must be 0 or 1")
    return value == "1"




def _r16_xpu_stack_enabled() -> bool:
    """Return whether XPU video-VA eager NA may batch compatible query tiles."""
    if os.environ.get("LTX_ALL_ORIG", "0") == "1":
        return False
    value = os.environ.get("LTX_R16_VAE_NA_STACK", "1")
    if value not in {"0", "1"}:
        raise ValueError("LTX_R16_VAE_NA_STACK must be 0 or 1")
    return value == "1"


def _r22_sdpa_rest_enabled() -> bool:
    """Return whether XPU video-VA eager NA may batch equal-shaped geometry buckets."""
    if os.environ.get("LTX_ALL_ORIG", "0") == "1":
        return False
    value = os.environ.get("LTX_R22_SDPA_REST", "0")
    if value not in {"0", "1"}:
        raise ValueError("LTX_R22_SDPA_REST must be 0 or 1")
    return value == "1"


def _r22_rest_tiles(dims: tuple[int, int, int], kernels: list[int]) -> tuple[int, int, int]:
    """Return the fixed R22 query-tile geometry clipped to each tensor extent."""
    del kernels
    return tuple(min(extent, tile) for extent, tile in zip(dims, NA_XPU_REST_TILE, strict=True))


def _r28_na_cache_enabled() -> bool:
    """Return whether XPU NA may reuse static gather indices and group masks."""
    if os.environ.get("LTX_ALL_ORIG", "0") == "1":
        return False
    value = os.environ.get("LTX_R28_NA_CACHE", "0")
    if value not in {"0", "1"}:
        raise ValueError("LTX_R28_NA_CACHE must be 0 or 1")
    return value == "1"


def _window_bounds(length: int, kernel: int, causal: bool) -> tuple[list[int], list[int]]:
    """Per-index (start, end) of the attended window along one axis."""
    starts: list[int] = []
    ends: list[int] = []
    if causal:
        for i in range(length):
            starts.append(max(0, i - kernel + 1))
            ends.append(i + 1)
    else:
        kernel = min(kernel, length)
        lo = length - kernel
        half = kernel // 2
        for i in range(length):
            start = min(max(i - half, 0), lo)
            starts.append(start)
            ends.append(start + kernel)
    return starts, ends


def _pick_tiles(dims: tuple[int, int, int], kernels: list[int]) -> list[int]:
    """Per-axis query-tile lengths keeping one tile's [Nq, Nk] under budget."""
    tiles = list(dims)

    def cost(ts: list[int]) -> int:
        nq = math.prod(ts)
        nk = math.prod(min(d, t + k - 1) for t, k, d in zip(ts, kernels, dims, strict=True))
        return nq * nk

    while cost(tiles) > NA_SCORE_BUDGET and max(tiles) > 1:
        i = max(range(3), key=lambda a: tiles[a] / kernels[a])
        if tiles[i] <= 1:
            break
        tiles[i] = max(1, (tiles[i] + 1) // 2)
    return tiles


def _group_mask_uncached(
    rel_bounds: tuple[tuple[tuple[int, ...], tuple[int, ...]], ...],
    dtype: torch.dtype,
    device: torch.device,
) -> torch.Tensor:
    """Construct one additive geometry mask without a persistent cache."""
    bools = []
    for starts, ends in rel_bounds:
        st = torch.tensor(starts, device=device)
        en = torch.tensor(ends, device=device)
        kj = torch.arange(int(en.max()), device=device)
        bools.append((kj[None, :] >= st[:, None]) & (kj[None, :] < en[:, None]))
    visible = (
        bools[0][:, None, None, :, None, None]
        & bools[1][None, :, None, None, :, None]
        & bools[2][None, None, :, None, None, :]
    )
    nq = visible.shape[0] * visible.shape[1] * visible.shape[2]
    nk = visible.shape[3] * visible.shape[4] * visible.shape[5]
    mask = torch.zeros((nq, nk), dtype=dtype, device=device)
    mask.masked_fill_(~visible.reshape(nq, nk), torch.finfo(dtype).min)
    return mask.reshape(1, 1, nq, nk)


def _group_mask(
    rel_bounds: tuple[tuple[tuple[int, ...], tuple[int, ...]], ...],
    dtype: torch.dtype,
    device: torch.device,
) -> torch.Tensor:
    """Additive ``[1, 1, Nq, Nk]`` mask for one tile-geometry group."""
    if _r28_na_cache_enabled():
        key = (repr(rel_bounds), str(dtype), str(device))
        hit = _R28_NA_MASK_CACHE.get(key)
        if hit is not None:
            return hit
    shaped = _group_mask_uncached(rel_bounds, dtype, device)
    if _r28_na_cache_enabled():
        _R28_NA_MASK_CACHE[(repr(rel_bounds), str(dtype), str(device))] = shaped
    return shaped


def _xpu_batch_index(
    starts: list[list[int]],
    extents: tuple[int, int, int],
    batch: int,
    heads: int,
    dims: tuple[int, int, int],
    device: torch.device,
) -> torch.Tensor:
    """Flat XPU indices for a rectangular batch of spatial windows."""
    if _r28_na_cache_enabled():
        _r28_ikey = (
            tuple(tuple(s) for s in starts),
            tuple(extents),
            batch,
            heads,
            tuple(dims),
            str(device),
        )
        _r28_ihit = _R28_NA_INDEX_CACHE.get(_r28_ikey)
        if _r28_ihit is not None:
            return _r28_ihit
    nt, nh_dim, nw = extents
    t, h, w = dims
    start = torch.tensor(starts, dtype=torch.long, device=device)
    b = torch.arange(batch, dtype=torch.long, device=device).reshape(1, batch, 1, 1)
    head = torch.arange(heads, dtype=torch.long, device=device).reshape(1, 1, heads, 1)
    t0 = start[:, None, None, None, 0]
    h0 = start[:, None, None, None, 1]
    w0 = start[:, None, None, None, 2]
    base = (((b * t + t0) * h + h0) * w + w0) * heads + head
    tc = torch.arange(nt, dtype=torch.long, device=device).reshape(1, 1, 1, nt, 1, 1)
    hc = torch.arange(nh_dim, dtype=torch.long, device=device).reshape(1, 1, 1, 1, nh_dim, 1)
    wc = torch.arange(nw, dtype=torch.long, device=device).reshape(1, 1, 1, 1, 1, nw)
    offset = ((tc * h * w + hc * w + wc) * heads).reshape(1, 1, 1, nt * nh_dim * nw)
    index = (base + offset).reshape(-1)
    if _r28_na_cache_enabled():
        _R28_NA_INDEX_CACHE[(
            tuple(tuple(s) for s in starts),
            tuple(extents),
            batch,
            heads,
            tuple(dims),
            str(device),
        )] = index
    return index


def _xpu_gather_batch(
    x: torch.Tensor,
    index: torch.Tensor,
    group_size: int,
    batch: int,
    heads: int,
    length: int,
    head_dim: int,
) -> torch.Tensor:
    """Gather one contiguous XPU tensor into an SDPA batch layout."""
    return x.reshape(-1, head_dim).index_select(0, index).reshape(group_size * batch, heads, length, head_dim)


def _xpu_batch_from_slices(
    x: torch.Tensor,
    slices: list[tuple[slice, slice, slice]],
    extents: tuple[int, int, int],
    batch: int,
    heads: int,
    length: int,
    head_dim: int,
) -> torch.Tensor:
    """Build one rectangular SDPA batch from contiguous or strided spatial slices."""
    if x.is_contiguous():
        index = _xpu_batch_index(
            [[part[0].start, part[1].start, part[2].start] for part in slices],
            extents,
            batch,
            heads,
            (x.shape[1], x.shape[2], x.shape[3]),
            x.device,
        )
        return _xpu_gather_batch(x, index, len(slices), batch, heads, length, head_dim)
    stacked = torch.stack([x[:, part[0], part[1], part[2]] for part in slices])
    return stacked.permute(0, 1, 5, 2, 3, 4, 6).reshape(len(slices) * batch, heads, length, head_dim)


def _xpu_cached_batch_from_slices(
    x: torch.Tensor,
    slices: list[tuple[slice, slice, slice]],
    extents: tuple[int, int, int],
    batch: int,
    heads: int,
    length: int,
    head_dim: int,
    cache_kind: str,
) -> torch.Tensor:
    """Build one rectangular SDPA batch with the applicable XPU gather cache."""
    if not x.is_contiguous() or _r28_na_cache_enabled():
        return _xpu_batch_from_slices(x, slices, extents, batch, heads, length, head_dim)
    starts = tuple((part[0].start, part[1].start, part[2].start) for part in slices)
    key = (cache_kind, starts, extents, tuple(x.shape[1:4]), batch, heads, str(x.device))
    index = _R22_INDEX_CACHE.get(key)
    if index is _CACHE_MISS:
        index = _xpu_batch_index([list(start) for start in starts], extents, batch, heads, tuple(x.shape[1:4]), x.device)
        _R22_INDEX_CACHE.put(key, index)
    return _xpu_gather_batch(x, index, len(slices), batch, heads, length, head_dim)


def _slice_extent(slices: tuple[slice, slice, slice]) -> tuple[int, int, int]:
    """Return the three spatial extents of a tile slice."""
    t0, t1, t2 = (part.stop - part.start for part in slices)
    return t0, t1, t2


def _xpu_rest_batched_na3d(
    q: torch.Tensor,
    k: torch.Tensor,
    v: torch.Tensor,
    dims: tuple[int, int, int],
    groups: dict[
        tuple[
            tuple[tuple[int, ...], tuple[int, ...]],
            tuple[tuple[int, ...], tuple[int, ...]],
            tuple[tuple[int, ...], tuple[int, ...]],
        ],
        list[tuple[tuple[slice, slice, slice], tuple[slice, slice, slice]]],
    ],
    device: torch.device,
) -> torch.Tensor:
    """Run equal-shaped XPU NA tiles with one additive mask per batch item."""
    batch, t, h, w, nh, hd = q.shape
    buckets: dict[
        tuple[tuple[int, int, int], tuple[int, int, int]],
        list[
            tuple[
                tuple[tuple[tuple[int, ...], tuple[int, ...]], ...],
                tuple[slice, slice, slice],
                tuple[slice, slice, slice],
            ]
        ],
    ] = {}
    for rel_bounds, tiles in groups.items():
        q_extent = _slice_extent(tiles[0][0])
        k_extent = _slice_extent(tiles[0][1])
        bucket = buckets.setdefault((q_extent, k_extent), [])
        bucket.extend((rel_bounds, query_slices, key_slices) for query_slices, key_slices in tiles)

    out = torch.empty((batch, t, h, w, nh, hd), device=device, dtype=v.dtype)
    for (q_extent, k_extent), bucket in buckets.items():
        nq = math.prod(q_extent)
        nk = math.prod(k_extent)
        if min(batch, nh, nk, hd) <= 0:
            raise RuntimeError(
                "LTX_R22_SDPA_REST: invalid XPU NA dimensions "
                f"(batch={batch}, nh={nh}, nk={nk}, hd={hd})"
            )
        kv_bytes_per_tile = batch * nh * nk * hd * 2 * k.element_size()
        g_max = min(NA_XPU_REST_TILE_CAP, NA_KV_STACK_BUDGET * 2 // kv_bytes_per_tile)
        if g_max < 1:
            raise RuntimeError(
                "LTX_R22_SDPA_REST: one XPU K/V stack exceeds the 512 MiB budget "
                f"(dtype={k.dtype}, bytes_per_tile={kv_bytes_per_tile})"
            )
        for c0 in range(0, len(bucket), g_max):
            chunk = bucket[c0 : c0 + g_max]
            g = len(chunk)
            q_slices = [item[1] for item in chunk]
            k_slices = [item[2] for item in chunk]
            q_s = _xpu_cached_batch_from_slices(q, q_slices, q_extent, batch, nh, nq, hd, "q")
            k_s = _xpu_cached_batch_from_slices(k, k_slices, k_extent, batch, nh, nk, hd, "k")
            v_s = _xpu_cached_batch_from_slices(v, k_slices, k_extent, batch, nh, nk, hd, "k")
            rel_key = tuple(item[0] for item in chunk)
            cache_key = (str(device), str(q.dtype), q_extent, k_extent, batch, g, rel_key)
            mask = _R22_STACK_CACHE.get(cache_key)
            if mask is _CACHE_MISS:
                masks = [_group_mask_uncached(rel_bounds, q.dtype, device) for rel_bounds, _, _ in chunk]
                mask = torch.stack(masks, dim=0)
                mask = mask.expand(g, batch, 1, nq, nk).reshape(g * batch, 1, nq, nk)
                _R22_STACK_CACHE.put(cache_key, mask)
            result = functional.scaled_dot_product_attention(q_s, k_s, v_s, attn_mask=mask, scale=1.0)
            result = result.view(g, batch, nh, nq, hd)
            for i, item in enumerate(chunk):
                query_slices = item[1]
                tile_output = result[i].reshape(batch, nh, *q_extent, hd).permute(0, 2, 3, 4, 1, 5)
                out[:, query_slices[0], query_slices[1], query_slices[2]] = tile_output
    return out


def na3d(
    q: torch.Tensor,
    k: torch.Tensor,
    v: torch.Tensor,
    kernel_size: list[int] | tuple[int, ...],
    is_causal: list[bool] | None = None,
    scale: float | None = None,
) -> torch.Tensor:
    """3D neighborhood attention over ``(B, T, H, W, NH, HD)`` tensors.
    ``scale`` defaults to ``head_dim**-0.5``. Pass ``scale=1.0`` when Q is already scaled.
    """
    batch, t, h, w, nh, hd = q.shape
    dims = (t, h, w)
    causal = [False, False, False] if is_causal is None else list(is_causal)
    kernels = [k_ if c else min(k_, d) for k_, c, d in zip(kernel_size, causal, dims, strict=True)]
    if scale is None:
        scale = hd**-0.5
    device = q.device
    xpu_stack_batching = device.type == "xpu" and _r16_xpu_stack_enabled()
    if scale != 1.0:
        q = q * scale

    bounds = [_window_bounds(d, k_, c) for d, k_, c in zip(dims, kernels, causal, strict=True)]
    r22_stack_batching = (
        xpu_stack_batching
        and _r22_sdpa_rest_enabled()
        and max(kernels) <= NA_XPU_REST_MAX_KERNEL
    )
    if r22_stack_batching:
        tile_t, tile_h, tile_w = _r22_rest_tiles(dims, kernels)
    else:
        tile_t, tile_h, tile_w = _pick_tiles(dims, [min(k_, d) for k_, d in zip(kernels, dims, strict=True)])

    groups: dict[
        tuple[
            tuple[tuple[int, ...], tuple[int, ...]],
            tuple[tuple[int, ...], tuple[int, ...]],
            tuple[tuple[int, ...], tuple[int, ...]],
        ],
        list[tuple[tuple[slice, slice, slice], tuple[slice, slice, slice]]],
    ] = {}
    for t0 in range(0, t, tile_t):
        t1 = min(t0 + tile_t, t)
        rt0, rt1 = bounds[0][0][t0], bounds[0][1][t1 - 1]
        rel_t = (
            tuple(s - rt0 for s in bounds[0][0][t0:t1]),
            tuple(e - rt0 for e in bounds[0][1][t0:t1]),
        )
        for h0 in range(0, h, tile_h):
            h1 = min(h0 + tile_h, h)
            rh0, rh1 = bounds[1][0][h0], bounds[1][1][h1 - 1]
            rel_h = (
                tuple(s - rh0 for s in bounds[1][0][h0:h1]),
                tuple(e - rh0 for e in bounds[1][1][h0:h1]),
            )
            for w0 in range(0, w, tile_w):
                w1 = min(w0 + tile_w, w)
                rw0, rw1 = bounds[2][0][w0], bounds[2][1][w1 - 1]
                rel_w = (
                    tuple(s - rw0 for s in bounds[2][0][w0:w1]),
                    tuple(e - rw0 for e in bounds[2][1][w0:w1]),
                )
                groups.setdefault((rel_t, rel_h, rel_w), []).append(
                    (
                        (slice(t0, t1), slice(h0, h1), slice(w0, w1)),
                        (slice(rt0, rt1), slice(rh0, rh1), slice(rw0, rw1)),
                    )
                )

    if r22_stack_batching:
        return _xpu_rest_batched_na3d(q, k, v, dims, groups, device)

    out = torch.empty((batch, t, h, w, nh, hd), device=device, dtype=v.dtype)
    for rel, tiles in groups.items():
        mask = _group_mask(rel, q.dtype, device)
        nq, nk = mask.shape[2], mask.shape[3]
        if device.type == "cuda":
            g_max = max(1, NA_KV_STACK_BUDGET // max(1, batch * nh * nk * hd * 2))
        elif xpu_stack_batching:
            if min(batch, nh, nk, hd) <= 0:
                raise RuntimeError(
                    "LTX_R16_VAE_NA_STACK: invalid XPU NA dimensions "
                    f"(batch={batch}, nh={nh}, nk={nk}, hd={hd})"
                )
            kv_bytes_per_tile = batch * nh * nk * hd * 2 * k.element_size()
            g_max = NA_KV_STACK_BUDGET * 2 // kv_bytes_per_tile
            g_max = min(g_max, NA_XPU_KV_STACK_TILE_CAP)
            if g_max < 1:
                raise RuntimeError(
                    "LTX_R16_VAE_NA_STACK: one XPU K/V stack exceeds the 512 MiB budget "
                    f"(dtype={k.dtype}, bytes_per_tile={kv_bytes_per_tile})"
                )
        else:
            g_max = 1
        qs0, _ = tiles[0]
        tq = qs0[0].stop - qs0[0].start
        th = qs0[1].stop - qs0[1].start
        tw = qs0[2].stop - qs0[2].start
        for c0 in range(0, len(tiles), g_max):
            chunk = tiles[c0 : c0 + g_max]
            g = len(chunk)
            if (
                xpu_stack_batching
                and (g > 1 or _r29_g1_gather_enabled())
                and q.is_contiguous()
                and k.is_contiguous()
                and v.is_contiguous()
            ):
                query_slices = [item[0] for item in chunk]
                key_slices = [item[1] for item in chunk]
                q_extent = (
                    query_slices[0][0].stop - query_slices[0][0].start,
                    query_slices[0][1].stop - query_slices[0][1].start,
                    query_slices[0][2].stop - query_slices[0][2].start,
                )
                k_extent = (
                    key_slices[0][0].stop - key_slices[0][0].start,
                    key_slices[0][1].stop - key_slices[0][1].start,
                    key_slices[0][2].stop - key_slices[0][2].start,
                )
                q_index = _xpu_batch_index(
                    [[s[0].start, s[1].start, s[2].start] for s in query_slices],
                    q_extent,
                    batch,
                    nh,
                    dims,
                    device,
                )
                kv_index = _xpu_batch_index(
                    [[s[0].start, s[1].start, s[2].start] for s in key_slices],
                    k_extent,
                    batch,
                    nh,
                    dims,
                    device,
                )
                q_s = _xpu_gather_batch(q, q_index, g, batch, nh, nq, hd)
                k_s = _xpu_gather_batch(k, kv_index, g, batch, nh, nk, hd)
                v_s = _xpu_gather_batch(v, kv_index, g, batch, nh, nk, hd)
            else:
                q_s = torch.stack([q[:, qs[0], qs[1], qs[2]] for qs, _ in chunk])
                k_s = torch.stack([k[:, rs[0], rs[1], rs[2]] for _, rs in chunk])
                v_s = torch.stack([v[:, rs[0], rs[1], rs[2]] for _, rs in chunk])
                q_s = q_s.permute(0, 1, 5, 2, 3, 4, 6).reshape(g * batch, nh, nq, hd)
                k_s = k_s.permute(0, 1, 5, 2, 3, 4, 6).reshape(g * batch, nh, nk, hd)
                v_s = v_s.permute(0, 1, 5, 2, 3, 4, 6).reshape(g * batch, nh, nk, hd)
            o = functional.scaled_dot_product_attention(q_s, k_s, v_s, attn_mask=mask, scale=1.0)
            o = o.view(g, batch, nh, tq, th, tw, hd).permute(0, 1, 3, 4, 5, 2, 6)
            for i, (qs, _) in enumerate(chunk):
                out[:, qs[0], qs[1], qs[2]] = o[i]

    return out
